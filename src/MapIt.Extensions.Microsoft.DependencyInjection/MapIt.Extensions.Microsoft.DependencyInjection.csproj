<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>MapIt.Extensions.Microsoft.DependencyInjection</RootNamespace>
    <AssemblyName>MapIt.Extensions.Microsoft.DependencyInjection</AssemblyName>
    <PackageId>MapIt.Extensions.Microsoft.DependencyInjection</PackageId>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>ASP.NET Core / Microsoft.Extensions.DependencyInjection integration for MapIt.</Description>
    <PackageTags>mapper;mapping;dependency-injection;aspnet-core</PackageTags>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <ProjectReference Include="..\MapIt\MapIt.csproj" />
  </ItemGroup>

</Project>
